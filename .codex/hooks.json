{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.cheat-hooks/codex-prediction-immutability.py\"",
            "timeout": 3,
            "statusMessage": "Protecting immutable predictions"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" bash \"$(git rev-parse --show-toplevel)/.cheat-hooks/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading content status"
          }
        ]
      }
    ]
  }
}
